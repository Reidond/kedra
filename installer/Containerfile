# Separate Anaconda environment. The installed desktop is a distinct OCI payload.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG PAYLOAD_IMAGE
ARG SOURCE_DATE_EPOCH
RUN dnf -y --best --refresh --repo=fedora --repo=updates \
      '--setopt=*.skip_if_unavailable=False' '--setopt=*.gpgcheck=True' \
      install anaconda anaconda-install-img-deps anaconda-dracut \
      dracut-config-generic dracut-network net-tools squashfs-tools \
      grub2-efi-x64-cdboot grub2-pc-modules xorrisofs isomd5sum \
      python-unversioned-command plymouth default-fonts-core-sans \
      default-fonts-other-sans google-noto-sans-cjk-fonts && \
    dnf clean all && \
    mkdir -p /boot/efi /var/mnt && \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY prepare.sh /tmp/kedra-installer-prepare.sh
COPY boot-probe.service /usr/lib/systemd/system/kedra-installer-boot-probe.service
COPY boot-probe.sh /usr/libexec/kedra-installer-boot-probe
COPY anaconda-adapter.py /tmp/kedra-anaconda-adapter.py
COPY finalize-fstab.py /usr/libexec/kedra-installer-finalize-fstab.py
COPY test-finalize-fstab.py /tmp/test-finalize-fstab.py
RUN test -n "$PAYLOAD_IMAGE" && \
    printf 'bootc --source-imgref containers-storage:%s --target-imgref %s\nrootpw --lock\n' \
      "$PAYLOAD_IMAGE" "$PAYLOAD_IMAGE" > /usr/share/anaconda/interactive-defaults.ks && \
    printf '\n%%post --nochroot --erroronfail\n/usr/bin/python3 /usr/libexec/kedra-installer-finalize-fstab.py\n%%end\n' >> /usr/share/anaconda/interactive-defaults.ks && \
    /bin/bash /tmp/kedra-installer-prepare.sh && \
    python3 /tmp/kedra-anaconda-adapter.py && \
    cp /usr/libexec/kedra-installer-finalize-fstab.py /tmp/finalize-fstab.py && \
    python3 /tmp/test-finalize-fstab.py && \
    chmod 0755 /usr/libexec/kedra-installer-boot-probe && \
    systemctl enable kedra-installer-boot-probe.service && \
    rm /tmp/kedra-installer-prepare.sh /tmp/kedra-anaconda-adapter.py /tmp/finalize-fstab.py /tmp/test-finalize-fstab.py
