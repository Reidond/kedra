[Unit]
Description=Explicit disposable installer boot probe
ConditionKernelCommandLine=kedra.research=1
After=basic.target

[Service]
Type=oneshot
ExecStart=/bin/bash -ec 'test "$(getenforce)" = Enforcing; printf "KEDRA_INSTALLER_ENFORCING_BOOT_PASS\\n" > /dev/ttyS1'

[Install]
WantedBy=anaconda.target
