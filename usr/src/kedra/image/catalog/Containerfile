# Unsigned native package builder; BASE_IMAGE is the exact retained foundation alias.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BUILDER_ROLE
COPY builder.sh /tmp/kedra-catalog-builder.sh
COPY install-rpms.sh /tmp/kedra-install-rpms.sh
# rpms/ is this role's offline repository of the run's RPM lock.
RUN --mount=type=bind,source=rpms,target=/run/kedra-rpms,ro \
    /bin/bash /tmp/kedra-catalog-builder.sh --build "$BUILDER_ROLE" \
    && rm /tmp/kedra-catalog-builder.sh /tmp/kedra-install-rpms.sh
