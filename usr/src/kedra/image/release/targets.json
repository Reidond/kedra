{
  "schema_version": 1,
  "targets": {
    "desktop": {
      "architecture": "x86_64",
      "oci_architecture": "amd64",
      "repository": "ghcr.io/reidond/kedra-desktop",
      "builds": "ghcr.io/reidond/kedra-desktop-builds",
      "runner": "ubuntu-24.04",
      "environment": "kedra-desktop-signing",
      "prefix": "KEDRA_DESKTOP",
      "public_key": "usr/src/kedra/image/release/authority/desktop.pub",
      "key_sha256": "usr/src/kedra/image/release/authority/desktop.sha256"
    },
    "qemu-arm64": {
      "architecture": "aarch64",
      "oci_architecture": "arm64",
      "repository": "ghcr.io/reidond/kedra-qemu-arm64",
      "builds": "ghcr.io/reidond/kedra-qemu-arm64-builds",
      "runner": "ubuntu-24.04-arm",
      "environment": "kedra-qemu-arm64-signing",
      "prefix": "KEDRA_QEMU_ARM64",
      "public_key": "usr/src/kedra/image/release/authority/qemu-arm64.pub",
      "key_sha256": "usr/src/kedra/image/release/authority/qemu-arm64.sha256"
    }
  }
}
