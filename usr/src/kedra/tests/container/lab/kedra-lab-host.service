[Unit]
Description=Kedra lab parent compositor for the nested niri session
Before=niri.service

[Service]
Type=exec
ExecStart=/usr/libexec/kedra-lab/host
# The Wayland socket must exist before niri connects to it.
ExecStartPost=/usr/bin/bash -c 'for i in $(seq 1 100); do test -S "$XDG_RUNTIME_DIR/wayland-host" && exit 0; sleep 0.1; done; exit 1'
