#!/bin/sh
# Disposable VM user session only; no owner credentials or passwordless production login.
set -eu
test "$(id -un)" = kedra-test
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
gnome-keyring-daemon --unlock --components=secrets < /run/kedra-lab/keyring-password >/dev/null
exec /usr/libexec/kedra-session
