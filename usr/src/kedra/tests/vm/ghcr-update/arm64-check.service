[Unit]
Description=Disposable signed full ARM release workflow
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/libexec/kedra-ghcr-check.py
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyAMA0
TimeoutStartSec=60min

[Install]
WantedBy=multi-user.target
